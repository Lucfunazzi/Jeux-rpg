<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="lancement.gui.EcranStagesController"
            styleClass="root-menu">
    <top>
        <StackPane>
            <VBox alignment="CENTER" spacing="6">
                <padding><Insets top="20" bottom="10"/></padding>
                <Label fx:id="titreLabel" styleClass="titre"/>
                <VBox fx:id="statsBox" alignment="CENTER"/>
            </VBox>
            <HBox fx:id="navigationChapitreBox" spacing="8" alignment="CENTER_RIGHT" StackPane.alignment="TOP_RIGHT">
                <padding><Insets top="16" right="20"/></padding>
                <Button fx:id="flecheGaucheButton" text="◀" onAction="#onChapitrePrecedent" styleClass="menu-bouton"/>
                <Button fx:id="flecheDroiteButton" text="▶" onAction="#onChapitreSuivant" styleClass="menu-bouton"/>
            </HBox>
        </StackPane>
    </top>

    <center>
        <ScrollPane fitToWidth="true">
            <VBox fx:id="stagesBox" alignment="CENTER" spacing="6">
                <padding><Insets top="10" bottom="10" left="60" right="60"/></padding>
            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <VBox alignment="CENTER" spacing="10">
            <padding><Insets top="10" bottom="20"/></padding>
            <HBox alignment="CENTER" spacing="10">
                <Button text="Retour" onAction="#onRetour" styleClass="menu-bouton"/>
                <Button text="Quêtes" onAction="#onQuetes" styleClass="menu-bouton"/>
                <Button fx:id="coffresButton" text="Coffres disponibles !" onAction="#onCoffres" styleClass="menu-bouton"/>
            </HBox>
        </VBox>
    </bottom>
</BorderPane>
