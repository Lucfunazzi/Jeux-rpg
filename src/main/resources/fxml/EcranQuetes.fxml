<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="lancement.gui.EcranQuetesController"
            styleClass="root-menu">
    <top>
        <VBox alignment="CENTER" spacing="10">
            <BorderPane.margin><Insets top="20" bottom="10"/></BorderPane.margin>
            <Label text="QUETES" styleClass="titre"/>
            <HBox alignment="CENTER" spacing="10">
                <Button fx:id="ongletChapitresButton" text="Quêtes de chapitre" onAction="#onOngletChapitres" styleClass="menu-bouton"/>
                <Button fx:id="ongletJournalieresButton" text="Quêtes journalières" onAction="#onOngletJournalieres" styleClass="menu-bouton"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-pane">
            <VBox fx:id="quetesBox" alignment="TOP_LEFT" spacing="8">
                <padding><Insets top="10" bottom="10" left="30" right="30"/></padding>
            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <VBox alignment="CENTER" spacing="10">
            <padding><Insets top="10" bottom="20"/></padding>
            <HBox alignment="CENTER" spacing="10">
                <Button text="Retour" onAction="#onRetour" styleClass="menu-bouton"/>
                <Button text="Menu Histoire" onAction="#onRetourHistoire" styleClass="menu-bouton"/>
            </HBox>
        </VBox>
    </bottom>
</BorderPane>
