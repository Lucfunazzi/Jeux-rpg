<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="lancement.gui.EcranInventaireController"
            styleClass="root-menu">
    <top>
        <Label text="INVENTAIRE" styleClass="titre" BorderPane.alignment="CENTER">
            <BorderPane.margin><Insets top="20" bottom="10"/></BorderPane.margin>
        </Label>
    </top>

    <center>
        <TabPane fx:id="ongletsInventaire" tabClosingPolicy="UNAVAILABLE" styleClass="root-menu">
            <Tab text="Équipements">
                <ScrollPane fitToWidth="true" styleClass="scroll-pane" prefHeight="340">
                    <padding><Insets left="30" right="30" top="10" bottom="10"/></padding>
                    <VBox fx:id="equipementsBox" spacing="8"/>
                </ScrollPane>
            </Tab>
            <Tab text="Fragments">
                <ScrollPane fitToWidth="true" styleClass="scroll-pane" prefHeight="340">
                    <padding><Insets left="30" right="30" top="10" bottom="10"/></padding>
                    <VBox fx:id="fragmentsBox" spacing="8"/>
                </ScrollPane>
            </Tab>
            <Tab text="Matériaux">
                <ScrollPane fitToWidth="true" styleClass="scroll-pane" prefHeight="340">
                    <padding><Insets left="30" right="30" top="10" bottom="10"/></padding>
                    <VBox fx:id="materiauxBox" spacing="8"/>
                </ScrollPane>
            </Tab>
            <Tab text="Consommables">
                <ScrollPane fitToWidth="true" styleClass="scroll-pane" prefHeight="340">
                    <padding><Insets left="30" right="30" top="10" bottom="10"/></padding>
                    <VBox fx:id="consommablesBox" spacing="8"/>
                </ScrollPane>
            </Tab>
            <Tab text="Pierres">
                <ScrollPane fitToWidth="true" styleClass="scroll-pane" prefHeight="340">
                    <padding><Insets left="30" right="30" top="10" bottom="10"/></padding>
                    <VBox fx:id="pierresBox" spacing="8"/>
                </ScrollPane>
            </Tab>
        </TabPane>
    </center>

    <bottom>
        <VBox alignment="CENTER" spacing="8">
            <padding><Insets top="10" bottom="20"/></padding>
            <Button text="Equiper un set complet" onAction="#onEquiperSet" styleClass="menu-bouton"/>
            <Button text="Boutique d'équipement" onAction="#onBoutiqueEquipement" styleClass="menu-bouton"/>
            <Button text="Retour" onAction="#onRetour" styleClass="menu-bouton"/>
        </VBox>
    </bottom>
</BorderPane>
