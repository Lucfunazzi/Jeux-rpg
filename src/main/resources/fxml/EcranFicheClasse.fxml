<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="lancement.gui.EcranFicheClasseController"
      alignment="TOP_CENTER" spacing="16" styleClass="root-menu">
    <padding><Insets top="24" bottom="20" left="30" right="30"/></padding>

    <Label fx:id="titreClasse" styleClass="titre"/>
    <Label fx:id="descriptionLabel" styleClass="texte" wrapText="true" maxWidth="520"/>

    <FlowPane fx:id="statsBox" hgap="10" vgap="10" alignment="CENTER" prefWrapLength="520"/>

    <VBox fx:id="competencesBox" spacing="12" alignment="TOP_CENTER" maxWidth="520">
        <padding><Insets top="6"/></padding>
    </VBox>

    <HBox spacing="16" alignment="CENTER">
        <padding><Insets top="10"/></padding>
        <Button text="Retour" onAction="#onRetour" styleClass="menu-bouton"/>
        <Button text="Choisir cette classe" onAction="#onChoisir" styleClass="menu-bouton"/>
    </HBox>
</VBox>
